NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=farmora_local
DB_USER=farmora_local
DB_PASS=
JWT_SECRET=replace-with-a-random-local-secret
LOG_LEVEL=info
# Generate once with: bun -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
# Keep this key stable and back it up; it encrypts secrets saved in Admin Settings.
PAYMENT_SETTINGS_ENCRYPTION_KEY=
# Save Razorpay credentials in Super Admin > Settings.
# Email (password reset links) is configured in Super Admin > Settings > Email.
# These are only a fallback used while that page has not been filled in.
# EMAIL_USER=you@gmail.com
# EMAIL_PASS=gmail-app-password
# FRONTEND_URL=https://farmora.in
# Local only: also log password reset links to the backend console.
# Ignored when NODE_ENV=production. Never enable on a server.
# LOG_PASSWORD_RESET_LINKS=true
