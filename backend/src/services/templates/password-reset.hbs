<html>
  <body style="margin:0;padding:24px;background:#f4f6f4;font-family:Arial,Helvetica,sans-serif;color:#1f2a1f;">
    <div style="max-width:560px;margin:auto;background:#ffffff;border:1px solid #e1e6e1;border-radius:10px;overflow:hidden;">
      <div style="background:#2f7d32;color:#ffffff;padding:16px 24px;font-size:18px;font-weight:bold;">Farmora</div>
      <div style="padding:24px;">
        <p style="margin:0 0 12px;">Hi {{name}},</p>
        <p style="margin:0 0 12px;">We received a request to reset the password for your Farmora account <strong>{{username}}</strong>.</p>
        <p style="margin:0 0 20px;">This link works once and expires in {{expiresMinutes}} minutes.</p>
        <p style="margin:0 0 24px;">
          <a href="{{resetUrl}}" style="display:inline-block;padding:12px 22px;background:#2f7d32;color:#ffffff;text-decoration:none;border-radius:6px;font-weight:bold;">Reset password</a>
        </p>
        <p style="margin:0 0 8px;font-size:13px;color:#5b665b;">If the button does not work, paste this link into your browser:</p>
        <p style="margin:0 0 20px;font-size:13px;word-break:break-all;"><a href="{{resetUrl}}" style="color:#2f7d32;">{{resetUrl}}</a></p>
        <p style="margin:0;font-size:13px;color:#5b665b;">If you did not ask for this, you can ignore this email. Your password will not change.</p>
      </div>
    </div>
  </body>
</html>
